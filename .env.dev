NODE_ENV=development
APP_NAME=digital-twin-platform

API_PORT=3000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=digital_twin
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_LOGGING=true
DB_SYNCHRONIZE=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_ACCESS_SECRET=dev_access_secret_please_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_please_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

STORAGE_DRIVER=local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=digital-twin
LOCAL_STORAGE_DIR=./uploads
UPLOAD_MAX_SIZE=524288000

VITE_APP_TITLE=数字孪生低代码平台
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:3000
VITE_USE_MOCK=false
VITE_CESIUM_TOKEN=
