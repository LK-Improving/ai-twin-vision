{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en",
  "allowCompoundWords": true,
  "useGitignore": true,
  "ignorePaths": [
    "node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "uploads/**",
    "docker/data/**",
    ".workbuddy/**",
    "pnpm-lock.yaml",
    "**/*.d.ts",
    "apps/frontend/builder/public/**",
    "docs/**",
    "**/*.log"
  ],
  "files": [
    "apps/**/*.{ts,vue,cjs}",
    "packages/**/*.{ts,vue}",
    "scripts/**/*.mjs",
    ".github/**/*.yml",
    "*.{cjs,json}"
  ],
  "words": [
    "amap",
    "amapearth",
    "accum",
    "ARCGIS",
    "bbox",
    "buildx",
    "Carto",
    "CINEON",
    "cmpt",
    "czml",
    "Dhbf",
    "dtiles",
    "fxaa",
    "gltf",
    "ILIKE",
    "isready",
    "mersenne",
    "minioadmin",
    "mqtts",
    "mqtt",
    "nestjs",
    "NINGBO",
    "nohup",
    "noopener",
    "noreferrer",
    "oplog",
    "Passw",
    "pnts",
    "pois",
    "psql",
    "segs",
    "Segoe",
    "Hiragino",
    "Menlo",
    "smhd",
    "ssao",
    "stylelint",
    "timescaledb",
    "threejs",
    "timestamptz",
    "topojson",
    "Tripo",
    "typecheck",
    "unsubs",
    "webst",
    "WMTS",
    "Xshare",
    "zhang",
    "zhangsan",
    "ZHONGYI",
    "zrender"
  ]
}
