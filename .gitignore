# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
*.tsbuildinfo
.vite/
coverage/
playwright-report/
test-results/

# e2e 产物：登录会话（含 token）、失败现场截图/视频/trace、HTML 报告
# 其中 .auth 绝对不能入库，否则 access/refresh token 会进版本库
e2e/.auth/
e2e/.artifacts/
e2e-report/

# env
# 真实环境文件一律不入库（含第三方服务密钥），仅 .env.example 作为模板跟踪
.env
.env.local
.env.*.local
.env.dev
.env.test
.env.prod
!.env.example

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# 一次性调试产物（脚本运行捕获、vite 解析 config 时的临时文件）
_tmp_*
vite.config.ts.timestamp-*.mjs
scripts/.tmp/

# 验证截图与临时 dump（根目录以 _ 开头的产物）
_*.png
_*.json

# editor
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db

# cache
.eslintcache
.cache/

# runtime data (docker volumes)
docker/data/

# uploaded assets (local storage fallback)
uploads/

# workbuddy runtime
.workbuddy/tmp/
