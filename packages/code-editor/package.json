{
  "name": "@dt/code-editor",
  "version": "1.0.0",
  "description": "企业级数字孪生低代码平台 — 嵌入式代码编辑器（CodeMirror 6 封装，Vue 适配）",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "build": "echo \"consumed as source via vite alias\"",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts,.vue",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.2",
    "@codemirror/language": "^6.10.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@codemirror/lang-javascript": "^6.2.2"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5",
    "vue": "^3.4.38",
    "vue-tsc": "^2.1.6"
  },
  "license": "MIT"
}
