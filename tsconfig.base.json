{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@dt/shared-types": ["packages/shared-types/src/index.ts"],
      "@dt/shared-types/*": ["packages/shared-types/src/*"],
      "@dt/rendering-engine": ["packages/rendering-engine/src/index.ts"],
      "@dt/rendering-engine/*": ["packages/rendering-engine/src/*"],
      "@dt/widgets": ["packages/widgets/src/index.ts"],
      "@dt/widgets/*": ["packages/widgets/src/*"],
      "@dt/layout-engine": ["packages/layout-engine/src/index.ts"],
      "@dt/layout-engine/*": ["packages/layout-engine/src/*"],
      "@dt/data-processor": ["packages/data-processor/src/index.ts"],
      "@dt/data-processor/*": ["packages/data-processor/src/*"],
      "@dt/code-editor": ["packages/code-editor/src/index.ts"],
      "@dt/code-editor/*": ["packages/code-editor/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", "coverage"]
}
