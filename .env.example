##############################################
# 企业级数字孪生低代码平台 — 环境变量模板
# 复制为 .env.dev / .env.test / .env.prod 后按环境修改
# docker compose --env-file .env.dev up -d
##############################################

# ---------- 运行环境 ----------
NODE_ENV=development
APP_NAME=digital-twin-platform

# ---------- 后端服务 (widget-server) ----------
API_PORT=3000
API_PREFIX=api
API_VERSION=v1
# CORS 白名单，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL ----------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=digital_twin
# TypeORM 连接池
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_LOGGING=false
DB_SYNCHRONIZE=false

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- JWT 双 Token ----------
JWT_ACCESS_SECRET=dev_access_secret_please_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_please_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d

# ---------- 对象存储 (MinIO / S3) ----------
STORAGE_DRIVER=local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=digital-twin
# 本地存储兜底目录（STORAGE_DRIVER=local 时生效）
LOCAL_STORAGE_DIR=./uploads
# 单文件最大 500MB
UPLOAD_MAX_SIZE=524288000

# ---------- 前端 (builder-server) ----------
VITE_APP_TITLE=数字孪生低代码平台
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:3000
# 后端未就绪时置 true，Axios 适配器返回本地 Mock 数据
VITE_USE_MOCK=false
VITE_CESIUM_TOKEN=
