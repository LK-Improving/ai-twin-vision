##############################################
# 企业级数字孪生低代码平台 — 环境变量模板
# 本文件是唯一入库的 env 文件，只放占位符，绝不写真实密钥
# 本地使用：cp .env.example .env.dev 后按环境修改
# .env.dev / .env.test / .env.prod 已全部列入 .gitignore，不会被提交
# docker compose -f docker/docker-compose.dev.yml --env-file .env.dev up -d
##############################################

# ---------- 运行环境 ----------
NODE_ENV=development
APP_NAME=digital-twin-platform

# ---------- 后端服务 (widget-server) ----------
API_PORT=3001
API_PREFIX=api
API_VERSION=v1
# CORS 白名单，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- PostgreSQL ----------
# 若本机 5432/6379 已被其他服务占用，改为 5433/6380 即可：
# docker-compose 会读同一份 env 文件，宿主端口映射与后端连接会同步错位
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=digital_twin
# TypeORM 连接池
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_LOGGING=false
# 生产环境严禁 synchronize：结构变更一律走 src/database/migrations/*（pnpm db:migrate）
DB_SYNCHRONIZE=false
# 应用启动时自动执行待处理迁移（迭代 8.2）：开发保持 false 并由 pnpm db:migrate 显式执行；
# 生产打开前请先备份库（基线迁移会读 src/database/sql/01_schema.sql，镜像内需包含该文件）
DB_MIGRATIONS_RUN=false

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------- 实时数据链路（Sprint 1） ----------
# MQTT 接入开关：false 时不建立 Broker 连接（如纯 HTTP 数据源场景）
MQTT_INGEST_ENABLED=true
# 默认 MQTT Broker（设备 connectionConfig.url 缺省时回落此地址）
MQTT_INGEST_BROKER_URL=mqtt://localhost:1883
MQTT_INGEST_USERNAME=
MQTT_INGEST_PASSWORD=
MQTT_INGEST_CLIENT_ID_PREFIX=dt-ingest
# 设备在线状态落库节流（毫秒）
MQTT_STATUS_THROTTLE_MS=30000

# ---------- JWT 双 Token ----------
JWT_ACCESS_SECRET=dev_access_secret_please_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_please_change_in_prod
JWT_REFRESH_EXPIRES_IN=7d
# 大屏票据有效期（秒）：/screen/:token 用它换取只读 WS 票据，过期需重新换
SCREEN_TICKET_TTL_SEC=7200

# ---------- 对象存储 (MinIO / S3) ----------
STORAGE_DRIVER=local
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=digital-twin
# 本地存储兜底目录（STORAGE_DRIVER=local 时生效）
LOCAL_STORAGE_DIR=./uploads
# 单文件最大 500MB
UPLOAD_MAX_SIZE=524288000

# ---------- 前端 (apps/frontend/builder) ----------
VITE_APP_TITLE=数字孪生低代码平台
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=ws://localhost:3001
# 后端未就绪时置 true，Axios 适配器返回本地 Mock 数据
VITE_USE_MOCK=false
VITE_CESIUM_TOKEN=

# ---------- L3 AI 生成服务适配位（详细设计 §16.3） ----------
# URL 与 Key 同时非空才启用对应策略；否则自动降级为程序化生成（不报错）
# 以下为第三方服务凭据，只允许填在本地 .env.dev，不得写入本模板
TEXT3D_API_URL=
TEXT3D_API_KEY=
TEXT3D_MODEL=v3.1-20260211
TEXT3D_TIMEOUT_MS=60000
GAUSSIAN_SPLAT_API_URL=
GAUSSIAN_SPLAT_API_KEY=
GAUSSIAN_SPLAT_TIMEOUT_MS=60000
AMAP_EARTH_API_URL=
AMAP_EARTH_API_KEY=
AMAP_EARTH_TIMEOUT_MS=60000
# 大模型规划器（LlmPlanner）：为空时回落到规则型 planner
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
