{
  "name": "digital-twin-lowcode-platform",
  "version": "0.1.0",
  "private": true,
  "description": "企业级数字孪生低代码平台 — Cesium 宏观地理 + Three.js 微观精细模型 + 低代码编排的 WebGL 数字孪生底座",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@10.22.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/**\" dev",
    "dev:web": "pnpm --filter @dt/builder dev",
    "dev:api": "pnpm --filter @dt/widget-server start:dev",
    "build": "pnpm -r build",
    "build:pkg": "pnpm --filter \"./packages/**\" build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm lint:projects && pnpm lint:root",
    "lint:projects": "pnpm -r lint",
    "lint:root": "eslint .eslintrc.cjs .stylelintrc.cjs commitlint.config.cjs",
    "lint:fix": "pnpm -r --if-present --parallel lint:fix",
    "lint:style": "stylelint \"apps/frontend/builder/src/**/*.{vue,css}\" \"packages/widgets/src/**/*.{vue,css}\" \"packages/rendering-engine/src/**/*.css\" --allow-empty-input",
    "lint:spell": "cspell lint --no-progress --relative",
    "format": "prettier --write \"**/*.{ts,tsx,vue,js,cjs,mjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,vue,js,cjs,mjs,json,md,yml,yaml,css}\"",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @dt/builder test:e2e",
    "infra:up": "docker compose -f docker/docker-compose.dev.yml --env-file .env.dev up -d",
    "infra:up:iot": "docker compose -f docker/docker-compose.dev.yml --env-file .env.dev --profile iot up -d",
    "infra:down": "docker compose -f docker/docker-compose.dev.yml down",
    "infra:logs": "docker compose -f docker/docker-compose.dev.yml logs -f",
    "iot:sim": "pnpm --filter @dt/widget-server exec node ../../../docker/iot-simulator.mjs",
    "db:migrate": "pnpm --filter @dt/widget-server migration:run",
    "db:revert": "pnpm --filter @dt/widget-server migration:revert",
    "db:status": "pnpm --filter @dt/widget-server migration:show",
    "db:check-drift": "node scripts/check-migration-drift.mjs --strict",
    "db:seed": "pnpm --filter @dt/widget-server seed",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@types/node": "^22.5.4",
    "@typescript-eslint/eslint-plugin": "^8.5.0",
    "@typescript-eslint/parser": "^8.5.0",
    "cspell": "^8.19.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.28.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "mqtt": "^5.15.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "typescript": "^5.5.4",
    "vue-eslint-parser": "^9.4.3"
  },
  "lint-staged": {
    "*.{ts,tsx,vue,js,cjs,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,vue}": [
      "stylelint --allow-empty-input"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@swc/core",
      "unrs-resolver"
    ]
  }
}
